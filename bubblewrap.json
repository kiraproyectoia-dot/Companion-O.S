
{
  "twaName": "Ly-Os",
  "launcherName": "Ly-Os",
  "packageName": "com.lyos.network.brain",
  "host": "lyos.web.app",
  "startUrl": "/",
  "iconUrl": "https://lyos.web.app/assets/icon-512.png",
  "maskableIconUrl": "https://lyos.web.app/assets/icon-512.png",
  "display": "standalone",
  "orientation": "portrait",
  "statusBarStyle": "transparent",
  "themeColor": "#000000",
  "themeColorDark": "#000000",
  "navigationColor": "#000000",
  "navigationColorDark": "#000000",
  "navigationDividerColor": "#000000",
  "navigationDividerColorDark": "#000000",
  "backgroundColor": "#000000",
  "enableNotifications": true,
  "enableSiteSettingsShortcut": true,
  "shortcuts": [],
  "webManifestUrl": "https://lyos.web.app/manifest.json",
  "fallbackType": "customtabs",
  "features": {
    "locationDelegation": true,
    "playBilling": false
  },
  "alphaCode": 1,
  "signingKey": {
    "path": "./lyos-keystore.jks",
    "alias": "lyos-key"
